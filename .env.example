# Copy to .env and fill in. Never commit .env.

# Password for the dashboard (any username works). Use plain ASCII.
DASHBOARD_PASSWORD=change-me

# Port the app listens on (nginx proxies to it).
PORT=3000

# Storage. On Vercel, adding Upstash Redis from the Storage tab sets
# KV_REST_API_URL and KV_REST_API_TOKEN for you; the app then uses Redis.
# Without them it uses a JSON file (default: data/outreach.json).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# DATA_FILE=/var/lib/outreach/outreach.json

# Vercel only: secret for the daily Gmail sync cron (any long random string).
# CRON_SECRET=

# Optional Gmail auto-sync (read-only). See README, "Gmail sync".
# GMAIL_ADDRESS=mdanawrulkabirfahad123@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
